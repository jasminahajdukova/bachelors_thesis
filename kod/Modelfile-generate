FROM qwen2.5:3b

SYSTEM """
You are generating a Dataster YAML configuration file for test data generation.

GENERATE RULES:
- Generate entry for EVERY table in the provided samples
- ALWAYS wrap values in single quotes: - 'tablename = count'
- Use ONLY type names that exist in the provided types section
- Return ONLY the generate: section, nothing else

OUTPUT RULES:
- Return ONLY raw YAML, no markdown fences, no ```yaml blocks
"""

PARAMETER temperature 0.3
PARAMETER num_predict 512


MESSAGE user """Generate ONLY the 'generate:' section for a Dataster YAML from a mysql database.
    
    Here are the generated types:
    types:
      Stations:
        station_id: 'seq(1,6,1)'
        region_code:
          - BLOCKS
          - NORD
          - SUED
          - WEST
        station_name: 'str_len([cC] 10,30)'
        altitude_m: 'interval(380,1245)'
        is_automated: 'bool'
      Readings:
        reading_id: 'seq(1,14,1)'
        station_id: 'interval(1,6)'
        weather_type:
          - BLOCKS
          - CLEAR
          - CLOUDY
          - RAIN
          - SNOW
        temperature_c: 'finterval(-12.3,4.9)'
        pressure_hpa: 'finterval(1007.6,1013.1)'
        humidity_pct: 'interval(31,52)'
        wind_kmh: 'interval(6,14)'
        measured_on: 'dinterval(2024-1-12,2024-3-1)'
    
    Return ONLY the generate section starting with 'generate:', nothing else."""

MESSAGE assistant """generate:
- 'Stations = 6'
- 'Readings = 14'"""


MESSAGE user """Generate ONLY the 'generate:' section for a Dataster YAML from a mysql database.
    
    Here are the generated types:
    types:
      airlines:
        airline_id: 'seq(1,6,1)'
        iata_code: 'str_len([cC] 2,3)'
        airline_name: 'str_len([cC] 10,30)'
        country_code: countries_cs
        is_lowcost: 'bool'
      airports:
        airport_id: 'seq(1,7,1)'
        iata_code: 'str_len([cC] 3,3)'
        airport_name: 'str_len([cC] 10,40)'
        city_country: 'str_len([cC] 10,30)'
        timezone_code:
          - BLOCKS
          - CET
          - EST
          - GMT
      aircraft:
        aircraft_id: 'seq(1,8,1)'
        airline_id: 'interval(1,6)'
        aircraft_type:
          - BLOCKS
          - A320
          - A321
          - A350
          - ATR72
          - B737
        seat_capacity: 'interval(70,325)'
        max_range_km: 'interval(1500,15000)'
        in_service: 'bool'
      flights:
        flight_id: 'seq(1,12,1)'
        aircraft_id: 'interval(1,8)'
        origin_airport: 'interval(1,7)'
        flight_code: 'regex(''[A-Z]{2,3}[0-9]{4}'')'
        status:
          - BLOCKS
          - BOARDING
          - CANCELLED
          - DELAYED
          - SCHEDULED
        duration_hours: 'finterval(1.6,2.05)'
        base_price_eur: 'finterval(39.99,59.5)'
        departure_date: 'dinterval(2024-7-1,2024-7-10)'
      bookings:
        booking_id: 'seq(1,15,1)'
        flight_id: 'interval(1,12)'
        passenger_first: first_names_cs
        passenger_last: last_names_cs
        seat_class:
          - BLOCKS
          - BUSINESS
          - ECONOMY
          - FIRST
        baggage_kg: 'finterval(15.0,19.0)'
        price_paid_eur: 'finterval(42.0,129.0)'
        booked_on: 'dinterval(2024-6-10,2024-6-18)'
        checked_in: 'bool'
    
    Return ONLY the generate section starting with 'generate:', nothing else."""

MESSAGE assistant """generate:
- 'airlines = 6'
- 'airports = 7'
- 'aircraft = 8'
- 'flights = 12'
- 'bookings = 15'"""